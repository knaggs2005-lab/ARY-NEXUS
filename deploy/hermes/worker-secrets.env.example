# Provision directly through a secure user-owned credential workflow; never print values.
# New dedicated bearer secret, >=32 cryptographically random bytes. No WebUI password reuse.
API_SERVER_KEY=
# Add ONLY the environment variable required by the chosen cloud inference provider.
# Prefer a separate scoped credential and provider-side spending cap.
# Reuse an existing credential only with explicit owner approval and secure transfer.

# Explicit selected key variable NAME, not a credential:
ARY_HERMES_PROVIDER_KEY_ENV=OPENAI_API_KEY
# Local read-only acceptance only: no model credential, _create_agent fails closed.
ARY_HERMES_LOCAL_ACCEPTANCE=1
