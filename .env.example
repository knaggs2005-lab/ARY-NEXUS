# Local single-user demo. Must be explicitly enabled; never enabled in production.
ARY_STORAGE=demo
# Required for Supabase mode: ARY_STORAGE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# openai | mock | compatible. Select mock explicitly for development; no silent fallback.
ARY_LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
# openai | local | compatible. Local is only a development substitute.
ARY_EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Schema uses vector(384). The selected embedding model MUST return 384 dimensions.

# Server-only. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.6-sol
# OpenAI embeddings use text-embedding-3-large with dimensions=384, versioned in code.
# Optional maintenance-user credentials for npm run reembed (otherwise use the signed-in dashboard).
ARY_SEED_EMAIL=
ARY_SEED_PASSWORD=

# Optional explicit routing when using multiple OpenAI organizations/projects.
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# Queue evidence-backed reflection after conversation turns. No additional LLM calls.
ARY_REFLECTION_ENABLED=true

# Voice adapters are independent of the reasoning provider. "disabled" disables voice.
ARY_STT_PROVIDER=openai
ARY_TTS_PROVIDER=openai
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Google Calendar: first external tool. Server-only; never NEXT_PUBLIC.
# Register a Web application OAuth client and enable Google Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3000/api/calendar/oauth/callback
# 32 random bytes encoded as 64 hexadecimal characters. Back up securely with vault.
ARY_INTEGRATION_ENCRYPTION_KEY=
# Encrypted single-host credential store; use a persistent private volume for deployment.
ARY_CALENDAR_VAULT_DIR=.data/calendar-vault

# Gmail: independent consent and connection from Calendar. Server-only credentials.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/gmail/oauth/callback
# Reuses ARY_INTEGRATION_ENCRYPTION_KEY and the encrypted vault with gmail: namespacing.

# Mac Desktop Bridge: disabled by default. Never put the launcher session token here.
# Bind to the authenticated Supabase owner UUID. No shared/demo bridge access.
ARY_DESKTOP_BRIDGE_ENABLED=false
ARY_DESKTOP_USER_ID=
# Reuses ARY_INTEGRATION_ENCRYPTION_KEY for private operation receipts.

# Ary Calls: disabled until a verified caller number, owner and destinations are deliberately configured.
ARY_CALLS_ENABLED=false
ARY_CALLS_PROVIDER=twilio
ARY_CALLS_USER_ID=
ARY_CALLS_FROM_NUMBER=
# Comma-separated E.164 numbers. US verified mobile/landline only in v1.
ARY_CALLS_ALLOWED_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Reuses ARY_INTEGRATION_ENCRYPTION_KEY for .data/calls-vault (single-host).

# Ary Creative: local Mac UXP bridge, disabled until explicitly configured.
ARY_PREMIERE_ENABLED=false
ARY_PREMIERE_USER_ID=
ARY_PREMIERE_BRIDGE_TOKEN=
# JSON array of absolute allowed project/media/preset/export folders.
ARY_PREMIERE_ALLOWED_ROOTS=[]
# Absolute FFmpeg executable for bounded local Premiere video/audio decoding.
# Homebrew on Apple Silicon: /opt/homebrew/bin/ffmpeg. Blank supports small PCM WAV only.
ARY_PREMIERE_FFMPEG_PATH=

# Design adapter: disabled, owner-bound native Cinema 4D plugin on loopback only.
ARY_DESIGN_ENABLED=false
ARY_DESIGN_USER_ID=
ARY_DESIGN_BRIDGE_TOKEN=
ARY_DESIGN_ALLOWED_ROOTS=[]

# Studio control: disabled by default; installed Mac app + pinned Supabase owner.
ARY_STUDIO_ENABLED=false
ARY_STUDIO_USER_ID=
# Absolute path to a reviewed JSON file following studio.example.json. No credentials in it.
ARY_STUDIO_CONFIG_PATH=
# Official Amaran OpenAPI AES-256 key, base64. Never sent to the browser or audit log.
ARY_AMARAN_API_KEY=
# Reuses ARY_INTEGRATION_ENCRYPTION_KEY for owner-scoped execution receipts.

# Perception: openai | disabled. Blank inherits openai only when ARY_LLM_PROVIDER=openai.
# Capture and analysis each require explicit approval, including at permission level 5.
ARY_VISION_PROVIDER=
# Blank inherits OPENAI_REASONING_MODEL. Must support image input and structured output.
OPENAI_VISION_MODEL=

# Explicit, per-user durable mission worker. No service-role key.
ARY_MISSION_WORKER_ENABLED=false
ARY_MISSION_ACCESS_TOKEN=

# Optional comma-separated existing OpenAI model IDs selectable by scoped workers (max 5).
# Empty keeps only the configured reasoning provider; does not alter the primary model.
ARY_AGENT_OPENAI_MODELS=

# MCP is opt-in. Owner-scoped manifest path; never put credentials in this JSON.
ARY_MCP_ENABLED=false
ARY_MCP_CONFIG_PATH=
# Manifest token_env names reference separate server-only environment secrets.

# Controlled digital eyes/hands. Requires existing desktop guard, owner and Supabase mode.
ARY_DIGITAL_CONTROL_ENABLED=false
# Exact comma-separated website origins; never the Nexus application origin.
ARY_BROWSER_ALLOWED_ORIGINS=
# Explicit installed app bundle IDs. Terminals, browsers and security settings excluded.
ARY_CONTROL_ALLOWED_APPS=
# Dedicated absolute transfer directory; supported non-executable documents, max 10 MB.
ARY_CONTROL_TRANSFER_DIR=

# Optional Home Assistant light adapter. Origin only; token stays server-side.
ARY_HOME_ASSISTANT_URL=
ARY_HOME_ASSISTANT_TOKEN=

# Opt-in interval delivery through the existing user-scoped Mission worker.
# Creates pinned Mission drafts; does not auto-start their tool steps.
ARY_AUTOMATION_WORKER_ENABLED=false

# ModelRouter: no new providers are enabled until explicitly configured here.
# false restores the previous single-provider behavior. Mock remains explicit only.
ARY_MODEL_ROUTER_ENABLED=true
ARY_MODEL_ROUTER_POLICY={"privacy":"cloud_allowed","preference":"balanced","timeout_ms":20000,"total_timeout_ms":45000}
# Optional per-task overrides: chat, analysis, planning, extraction.
# A local_only base privacy policy cannot be relaxed by a task override.
ARY_MODEL_ROUTER_TASKS={}
# Configure known context capacity/prices/priority for the existing primary model.
ARY_MODEL_ROUTER_PRIMARY={}
# Up to 8 additional text models; secrets are environment variable references, never JSON key values.
ARY_MODEL_ROUTER_TARGETS=[]
# Example local fallback (supply your actually installed model name/context limit):
# [{"id":"mac-local","provider":"mlx","model":"YOUR_INSTALLED_MODEL","location":"local","base_url":"http://127.0.0.1:8080/v1","tasks":["chat","analysis"],"capabilities":["reasoning","streaming"],"context_tokens":32768,"priority":10}]
# Cloud transports: anthropic uses native Messages; Gemini uses its compatible endpoint.
# Configure explicit model IDs, context limits and capabilities from your account/server.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Compatible inference is cloud-classified unless explicitly declared local on loopback.
# For a genuinely local primary: ARY_MODEL_ROUTER_PRIMARY={"location":"local"}
# A localhost gateway forwarding cloud requests is NOT local inference.
# For genuinely local compatible embeddings only, explicitly use local below.
ARY_EMBEDDING_LOCATION=cloud
# Text routing/privacy does not reconfigure STT, TTS, vision or database hosting.

# Subordinate cloud worker, server-only. Base URL is the HTTPS Hermes API root (not the hPanel UI).
HERMES_BASE_URL=
HERMES_ACCESS_KEY=
# Set true ONLY after independently confirming a dedicated advisory-only worker:
# all tools, MCPs, hooks, scheduling and external credentials disabled. Not a sandbox itself.
HERMES_RESTRICTED_WORKER_CONFIRMED=false

# Optional Twilio-hosted exact script for restricted trial accounts; empty uses inline TwiML.
ARY_CALLS_TRIAL_SCRIPT_URL=
ARY_CALLS_TRIAL_SCRIPT_DIGEST=
# Optional server-side OpenAI Realtime transport (Stage 2B; no browser exposure)
OPENAI_REALTIME_MODEL=
