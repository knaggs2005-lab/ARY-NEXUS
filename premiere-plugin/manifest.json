{
  "manifestVersion": 5,
  "id": "com.clevaryn.ary.creative",
  "name": "Ary Creative Bridge",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "requiredPermissions": {
    "network": { "domains": ["http://127.0.0.1:3000"] },
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "id": "arycreative",
      "type": "panel",
      "label": { "default": "Ary Creative Bridge" },
      "minimumSize": { "width": 320, "height": 400 },
      "preferredDockedSize": { "width": 400, "height": 600 }
    }
  ]
}
